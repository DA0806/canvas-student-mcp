# Configuración de Canvas LMS (Canvas Student)
# -------------------------------------------------------------
# 1. CANVAS_BASE_URL: URL del portal de Canvas de tu institución educativa.
#    Ejemplos:
#      - https://canvas.instructure.com
#      - https://universidad.instructure.com
#      - https://canvas.tucolegio.edu
CANVAS_BASE_URL=https://canvas.instructure.com

# 2. CANVAS_API_TOKEN: Token de acceso generado desde tu cuenta de Canvas.
#    Cómo obtenerlo:
#      1. Inicia sesión en tu cuenta de Canvas en el navegador.
#      2. Haz clic en "Cuenta" (Account) en el menú lateral izquierdo -> "Configuración" (Settings).
#      3. Baja hasta la sección "Tokens de acceso aprobados" (Approved Integrations).
#      4. Haz clic en "+ Nuevo token de acceso" (+ New Access Token).
#      5. Ponle un propósito (ej. "Asistente IA MCP") y genera el token.
#      6. Copia el token generado y pégalo aquí abajo:
CANVAS_API_TOKEN=tu_token_aqui
